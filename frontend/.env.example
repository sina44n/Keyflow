# KEYFLOW Frontend — Environment Variables Template
# Copy this file to .env (or .env.local) in the frontend directory and fill in your actual values.
# NEVER commit .env, secrets, or private API keys to version control.

# ===========================================================================
# 1. Backend API Base URL
# ===========================================================================
# In local development:
#   Leave blank or set to /api. Vite dev proxy (configured in vite.config.js)
#   automatically forwards requests to http://127.0.0.1:8000.
# In production (e.g. deployed on Vercel):
#   Set to your public Django REST API domain (e.g. https://api.keyflow.app/api
#   or https://your-backend.railway.app/api).
VITE_API_URL=

# ===========================================================================
# 2. Clerk Authentication
# ===========================================================================
# Obtain from your Clerk Dashboard -> API Keys -> Publishable Key
# In development: pk_test_...
# In production:  pk_live_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ===========================================================================
# 3. Google OAuth 2.0 Web Client ID (Legacy / Fallback)
# ===========================================================================
# Used if running without Clerk. When using Clerk, configure Google in Clerk Dashboard.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ===========================================================================
# Backend Pairing Reference (Configured in backend/.env)
# ===========================================================================
# The frontend relies on the Django backend for authentication and email delivery.
# Ensure your backend/.env is also configured with:
#   - FRONTEND_URL: Public URL of this frontend (e.g. http://localhost:5173 or https://keyflow.vercel.app)
#   - GOOGLE_CLIENT_ID: Matching Google Web Client ID for audience verification
#   - EMAIL_BACKEND / SMTP settings: For real password reset email delivery
#     (EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD, DEFAULT_FROM_EMAIL)
