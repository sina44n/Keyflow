# KEYFLOW Backend — Environment Variables Template
# Copy this to .env and fill in your actual values
# NEVER commit .env or secrets to version control

# ===========================================
# REQUIRED: Database Connection
# ===========================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# KEYFLOW requires PostgreSQL in production. SQLite can be used in local dev by setting:
#   DATABASE_URL=sqlite:///./db.sqlite3  (explicit developer choice)
DATABASE_URL=postgresql://keyflow_user:your_password_here@localhost:5432/keyflow_dev

# ===========================================
# Django Core Settings
# ===========================================
# Generate a new key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-at-least-50-chars-long-change-this-now

# Set to False in production — NEVER True in production
DEBUG=True

# Comma-separated list of valid hostnames (e.g. localhost,127.0.0.1,api.keyflow.app,your-backend.railway.app)
ALLOWED_HOSTS=localhost,127.0.0.1

# ===========================================
# CORS & CSRF — Frontend Origins
# ===========================================
# Comma-separated list of allowed frontend origins (e.g. http://localhost:5173,https://keyflow.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated list of trusted origins for CSRF protection
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===========================================
# Frontend Application URL & Google OAuth
# ===========================================
# Public frontend URL used to build absolute password-reset links (NO trailing slash)
# In development: http://localhost:5173
# In production: https://keyflow.vercel.app (or your custom domain)
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 Web Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
# Must match the audience claim of ID tokens generated by Google Sign-In
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ===========================================
# Clerk Authentication Configuration
# ===========================================
# Clerk Secret Key (Backend only, never expose to frontend)
CLERK_SECRET_KEY=sk_test_...

# Clerk Publishable Key (matches frontend)
CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk Issuer URL (e.g., https://verb-noun-00.clerk.accounts.dev or custom domain)
CLERK_ISSUER=https://your-app.clerk.accounts.dev

# Clerk JWKS URL for automatic public key rotation
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json

# Optional: Static PEM Public Key (Clerk Dashboard -> Configure -> Developers -> API Keys -> Advanced -> Show JWT Public Key)
# Formatted as a single line with \n or multiline string
# CLERK_PEM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"


# ===========================================
# Email Delivery (Password Reset & Verification)
# ===========================================
# Development backend (prints sent emails to terminal console):
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
#
# Production SMTP backend (e.g. SendGrid, Mailgun, AWS SES, Resend, Brevo):
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.yourmailprovider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=your_smtp_username_or_apikey
EMAIL_HOST_PASSWORD=your_smtp_password_or_token
DEFAULT_FROM_EMAIL=KEYFLOW <no-reply@keyflow.app>

# ===========================================
# Password Reset Security Settings
# ===========================================
# Token expiry time in hours (default: 24)
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=24
# Set to True to prevent user account enumeration (default: True)
DJANGO_REST_PASSWORDRESET_NO_INFORMATION_LEAKAGE=True

# ===========================================
# Production Security (applied automatically when DEBUG=False)
# ===========================================
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True


